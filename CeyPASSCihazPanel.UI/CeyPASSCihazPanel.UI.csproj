<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>CeyPASSCihazPanel</RootNamespace>
    <AssemblyName>CeyPASSCihazPanel</AssemblyName>
    <ApplicationIcon />
    <StartupObject>CeyPASSCihazPanel.Program</StartupObject>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="NPOI" Version="2.7.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CeyPASSCihazPanel.Business\CeyPASSCihazPanel.Business.csproj" />
    <ProjectReference Include="..\CeyPASSCihazPanel.DAL\CeyPASSCihazPanel.DAL.csproj" />
    <ProjectReference Include="..\CeyPASSCihazPanel.Entities\CeyPASSCihazPanel.Entities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>

  <Target Name="CopyConfigToOutput" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)App.config" DestinationFiles="$(OutputPath)$(AssemblyName).exe.config" SkipUnchangedFiles="true" />
  </Target>

  <!-- Registration-free COM: zkemkeeper.dll ve manifest cikti klasorune kopyalanir (regsvr32 gerekmez) -->
  <Target Name="CopyZkemkeeperToOutput" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)Libs\zkemkeeper.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)Libs\zkemkeeper.dll')" />
    <Copy SourceFiles="$(ProjectDir)zkemkeeper.sxs.manifest" DestinationFiles="$(OutputPath)zkemkeeper.sxs.manifest" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)zkemkeeper.sxs.manifest')" />
  </Target>

</Project>
